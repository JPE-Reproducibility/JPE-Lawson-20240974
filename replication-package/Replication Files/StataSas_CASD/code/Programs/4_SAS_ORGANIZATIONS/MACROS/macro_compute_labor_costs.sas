%macro calcot(annee);
	data t&annee. ; merge t&annee. q.txcot2 ; by an; if s_brut=. then delete; run;
	data t&annee.; set t&annee.;
	sbj = s_brut/duree;
	pss = pss_a/360;
	if substr(cs,1,1) in ('2','3') then cadre = 1; else cadre=0;
	sbrutm = sbj*30;
	if (nbheur>0) then sbh= s_brut/nbheur; else sbh = 1000000;
	if cadre = 0 then do;
		if sbj <= pss then do;
			css = sbj*s1prn;
			csp = sbj*p1prn;
			end;
		else if sbj <= 3*pss then do;
			css = pss*s1prn + (sbj-pss)*s3prn;
			csp = pss*p1prn + (sbj-pss)*p3prn;
			end;
		else if sbj <= 4*pss then do;
			css = pss*s1prn + 2*pss*s3prn + (sbj-3*pss)*s4prn;
			csp = pss*p1prn + 2*pss*p3prn + (sbj-3*pss)*p4prn;
			end;
		else if sbj > 4*pss then do;
			css = pss*s1prn + 2*pss*s3prn + pss*s4prn + (sbj-4*pss)*sprn;
			csp = pss*p1prn + 2*pss*p3prn + pss*p4prn + (sbj-4*pss)*pprn;
			end;
		end;
	else if cadre = 1 then do;
		if sbj <= pss then do;
			css = sbj*s1prc;
			csp = sbj*p1prc;
			end;
		else if sbj <= 4*pss then do;
			css = pss*s1prc + (sbj-pss)*s4prc;
			csp = pss*p1prc + (sbj-pss)*p4prc;
			end;
		else if sbj <= 8*pss then do;
			css = pss*s1prc + 3*pss*s4prc + (sbj-4*pss)*s8prc;
			csp = pss*p1prc + 3*pss*p4prc + (sbj-4*pss)*p8prc;
			end;
		else if sbj > 8*pss then do;
			css = pss*s1prc + 3*pss*s4prc + 4*pss*s8prc + (sbj-8*pss)*sprc;
			csp = pss*p1prc + 3*pss*p4prc + 4*pss*p8prc + (sbj-8*pss)*pprc;
			end;
		end;
		if sbj <= 4*pss then csg = sbj*csgcrds_act04; else if sbj>4*pss then csg = sbj*csgcrds_act4;
	cssa = css*duree;
	cspa = csp*duree;
	csga = csg*duree;
	drop pss p1prc p4prc p8prc pprc s1prc s4prc s8prc sprc p1prn p3prn p4prn pprn s1prn s3prn s4prn sprn csgcrds_act04 csgcrds_act4 ;
	run;
%mend;
